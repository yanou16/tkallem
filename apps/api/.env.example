# LLM (Groq or OpenRouter, swappable via LLM_PROVIDER)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Speech-to-text (Whisper via Groq)
STT_MODEL=whisper-large-v3-turbo

# Neon Postgres (server-side only)
DATABASE_URL=

# Clerk (verify JWTs from the web app)
CLERK_JWKS_URL=
CLERK_ISSUER=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Limits
MAX_AUDIO_BYTES=5000000
MAX_TEXT_CHARS=1000

# CORS: front domain only
FRONTEND_ORIGIN=http://localhost:3000
