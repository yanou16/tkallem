# LLM (Groq or OpenRouter, swappable via LLM_PROVIDER)
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3-235b-a22b-2507
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Agent tuning (optional, see packages/agent/README.md)
# OPENROUTER_PROVIDER_SORT=latency
# TKALLEM_HEDGE_AFTER=3
# LLM_TIMEOUT=20

# Speech-to-text (Whisper via Groq)
STT_MODEL=whisper-large-v3-turbo

# Neon Postgres (server-side only)
DATABASE_URL=
TEST_DATABASE_URL=

# Clerk (verify JWTs from the web app)
CLERK_JWKS_URL=
CLERK_ISSUER=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Limits
MAX_AUDIO_BYTES=5000000
MAX_TEXT_CHARS=1000

# CORS/Clerk allowed frontend origins, comma-separated for local + deployed apps
FRONTEND_ORIGIN=http://localhost:3000
