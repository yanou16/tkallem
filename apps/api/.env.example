# LLM (Groq or OpenRouter, swappable via LLM_PROVIDER)
LLM_PROVIDER=openrouter
# Backup models tried in order when the main one fails (rate limit, outage): provider:model, comma separated
LLM_FALLBACKS=openrouter:openai/gpt-4.1-mini,groq:qwen/qwen3.8-27b
LLM_MODEL=qwen/qwen3-235b-a22b-2507
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Agent tuning (optional, see packages/agent/README.md)
# OPENROUTER_PROVIDER_SORT=latency
# TKALLEM_HEDGE_AFTER=3
# LLM_TIMEOUT=20

# Voice: backup chain per direction (first tried first), compared with scripts/voice_bench.py
STT_PROVIDER=groq,deepinfra
TTS_PROVIDER=groq,deepinfra
STT_MODEL=whisper-large-v3-turbo
DEEPINFRA_API_KEY=

# Neon Postgres (server-side only)
DATABASE_URL=
TEST_DATABASE_URL=

# Clerk (verify JWTs from the web app)
CLERK_JWKS_URL=
CLERK_ISSUER=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Limits
MAX_AUDIO_BYTES=5000000
MAX_TEXT_CHARS=1000

# CORS: front domain only
FRONTEND_ORIGIN=http://localhost:3000

# Credits and guest mode (docs/CREDITS.md). Generate the secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GUEST_SECRET=
GUEST_CREDITS=40
LOGIN_BONUS=60
DAILY_REFILL=15
REFILL_CAP=45
GUEST_IP_DAILY_CAP=30
DAILY_SPEND_CAP=5000
GUEST_DAILY_CAP=2000
# Number of reverse proxies in front of the API (1 on Render or Railway). 0 = the socket address is the client.
FORWARDED_HOPS=0
