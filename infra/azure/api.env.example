# Production settings of the API on Azure App Service. Copy to infra/azure/api.env (git-ignored), fill in, then run
# deploy.sh: every line becomes an App Service application setting (an environment variable of the container).

# Database: a production branch of Neon, DIRECT connection string (not the -pooler one), with ?sslmode=require
DATABASE_URL=

# Clerk (Dashboard > API keys > Show JWT public key / Frontend API URL)
CLERK_JWKS_URL=
CLERK_ISSUER=

# The front's address(es), comma separated, exactly as in the browser (no trailing slash)
FRONTEND_ORIGIN=https://tkallem.vercel.app

# Language models and voice
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3-235b-a22b-2507
LLM_FALLBACKS=openrouter:openai/gpt-4.1-mini,groq:qwen/qwen3.8-27b
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
STT_PROVIDER=groq,deepinfra
TTS_PROVIDER=groq,deepinfra

# Guest mode and credits (docs/CREDITS.md, docs/OPERATIONS.md)
# Generate the secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GUEST_SECRET=
DAILY_SPEND_CAP=5000
BUDGET_ALERT_RATIO=0.8
ALERT_WEBHOOK_URL=

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
